---
import type { Retake } from '../../content/profile';
import { SHOW_PLACEHOLDERS } from '../../config';
interface Props { retake: Retake; title?: string }
const { retake, title = 'Retake strip' } = Astro.props;
const cells = [
  { k: 'Take one', sub: 'first attempt', v: retake.first, need: 'What failed or fell short on the first attempt' },
  { k: 'Take two', sub: 'what changed', v: retake.changed, need: 'What changed in the next attempt' },
  { k: 'What held', sub: 'still true', v: retake.held, need: 'What held' },
].filter((c) => c.v || SHOW_PLACEHOLDERS);
---
{cells.length > 0 && (
  <section class="retake mt-8" aria-label={title}>
    <h3 class="kicker" style="font-family:var(--font-mono)">{title}</h3>
    <ol class="mt-3 grid gap-3 sm:grid-cols-3">
      {cells.map((c, i) => (
        <li class:list={[c.v ? 'card' : 'placeholder', 'p-4']} data-placeholder={c.v ? undefined : ''}>
          <p class="kicker">{String(i + 1).padStart(2, '0')} · {c.k} <span class="sr-only">({c.sub})</span></p>
          {c.v ? <p class="mt-2">{c.v}</p> : <p class="mt-2"><strong>Placeholder · awaiting Emmanuel</strong>{c.need}</p>}
        </li>
      ))}
    </ol>
  </section>
)}
