---
import { works } from '../../content/profile';
const p = works.products;
---
<section class="wrap pt-10" aria-labelledby="h">
  <p class="kicker">Commercial + creative · fig. 3</p>
  <h1 id="h" class="display-1">{p.title}</h1>
  <p class="lede">{p.intro}</p>
</section>
<ol class="wrap products">
  {p.items.map((it, i) => (
    <li class="product" id={it.id}>
      <div class="product-title">
        <p class="kicker"><span class="chip">{it.status}</span>{it.period && <span class="ml-2">{it.period}</span>}</p>
        <h2 class="display-3 mt-2">{it.name}</h2>
        <p class="mt-3">{it.body}</p>
        <ul class="mt-3 flex flex-wrap gap-x-5">
          {it.links.map((l) => <li><a class="inline-flex min-h-11 items-center" href={l.href} rel="noopener">{l.label}</a></li>)}
          {it.caseFile && <li><a class="inline-flex min-h-11 items-center" href={it.caseFile}>Case file</a></li>}
        </ul>
      </div>
      <figure class="pflow">
        <ol aria-label={`How ${it.name} works`}>
          {it.flow.map(([k, n], j) => <li><span class="fig">{String.fromCharCode(97 + j)}</span><strong>{k}</strong>{n && <span class="pflow-note">{n}</span>}</li>)}
        </ol>
        <figcaption class="kicker">fig. 3.{i + 1} · data path</figcaption>
      </figure>
    </li>
  ))}
</ol>
<p class="wrap mt-14 text-xl" style="font-family:var(--font-serif)">{p.cta} <a class="btn-seal ml-2" href={p.ctaLink.href}>{p.ctaLink.label}</a></p>
