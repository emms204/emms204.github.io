---
import '../styles/global.css';
import { profile, atelier } from '../content/profile';
import Masthead from '../components/atelier/Masthead.astro';
import Footer from '../components/atelier/Footer.astro';

interface Props { title?: string; description?: string; noindex?: boolean; personLd?: boolean }
const { title = atelier.meta.title, description = atelier.meta.description, noindex = false, personLd = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, profile.meta.siteUrl).href;
const ogImage = new URL('/og.png', profile.meta.siteUrl).href;
// Person JSON-LD: verified facts only (profile.md §1, §3, §5; CV).
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.person.name,
  jobTitle: profile.person.role,
  url: profile.meta.siteUrl + '/',
  email: 'mailto:' + profile.contact.email,
  worksFor: { '@type': 'Organization', name: 'MasteryHive AI' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Ibadan' },
  knowsAbout: ['LLM agents', 'Automation', 'Python', 'FastAPI', 'Retrieval-augmented generation', 'Computer vision'],
  sameAs: ['https://github.com/emms204', 'https://www.linkedin.com/in/emmanuel-osanebi-1a7042222', 'https://medium.com/@emmxyz12'],
};
---
<!doctype html>
<html lang={profile.meta.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/fraunces-500.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F3EEE4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171F" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.person.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {personLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:px-4 focus:py-2" style="background:var(--paper-2)">Skip to content</a>
    <Masthead />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
