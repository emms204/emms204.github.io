---
import '../styles/global.css';
import { profile, works } from '../content/profile';
import TopBar from '../components/nav/TopBar.astro';
import QuestionLine from '../components/nav/QuestionLine.astro';
import NextQuestion from '../components/nav/NextQuestion.astro';
import { questionFor } from '../content/nav';
import Footer from '../components/atelier/Footer.astro';
import Backdrop from '../components/Backdrop.astro';
const BG_PICK = (import.meta.env.PUBLIC_BG || 'a') as string; // default: option A (Emmanuel, 19 Nov 2026)

interface Props { title?: string; description?: string; noindex?: boolean; personLd?: boolean; canonicalPath?: string }
const { title = works.meta.title, description = works.meta.description, noindex = false, personLd = false, canonicalPath } = Astro.props;
// Alias routes (/commission/, /shelf/, /press/, /sign/) pass canonicalPath so search engines index the new URL.
const canonical = new URL(canonicalPath ?? Astro.url.pathname, profile.meta.siteUrl).href;
const path = Astro.url.pathname.replace(/index\.html$/, '');
// Tidy-up a: the homepage is the front door (no question line or bar indicator); it still ends with Next question.
const front = path === '/';
const q = front ? null : questionFor(path);
const ogImage = new URL('/og.png', profile.meta.siteUrl).href;
// Person JSON-LD: verified facts only (profile.md §1, §3, §5; CV).
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.person.name,
  jobTitle: profile.person.role,
  url: profile.meta.siteUrl + '/',
  email: 'mailto:' + profile.contact.email,
  worksFor: { '@type': 'Organization', name: 'MasteryHive AI' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Ibadan' },
  knowsAbout: ['LLM agents', 'Automation', 'Python', 'FastAPI', 'Retrieval-augmented generation', 'Computer vision'],
  sameAs: ['https://github.com/emms204', 'https://www.linkedin.com/in/emmanuel-osanebi-1a7042222', 'https://medium.com/@emmxyz12'],
};
---
<!doctype html>
<html lang={profile.meta.locale} data-bg={/^[abc]$/.test(BG_PICK) ? BG_PICK : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/fraunces-500.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1014" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.person.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={works.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={works.meta.ogAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script is:inline>addEventListener('pagereveal',e=>{let f;try{f=sessionStorage.ixvt;sessionStorage.removeItem('ixvt')}catch(_){}const h=f&&e.viewTransition&&document.querySelector('main h1');if(h){h.style.viewTransitionName='ix-head';e.viewTransition.finished.finally(()=>h.style.viewTransitionName='')}})</script>
    {personLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body data-q={q ?? undefined} data-front={front ? '' : undefined} data-surface={front || (q && q !== 'think') ? 'grid' : 'plain'}>
    <Backdrop />
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:px-4 focus:py-2" style="background:var(--paper-2)">Skip to content</a>
    <TopBar q={q} path={path} />
    <main id="main" tabindex="-1">
      {q && <QuestionLine q={q} />}
      <slot />
      {(q || front) && <NextQuestion q={q ?? 'about'} />}
    </main>
    <Footer />
  </body>
</html>
