---
import Layout from '../layouts/Layout.astro';
import { atelier } from '../content/profile';
const n = atelier.notFound;
---
<Layout title={`${n.title} — page not found`} noindex>
  <section class="wrap py-24 text-center">
    <p class="kicker">404</p>
    <h1 class="mt-3 text-5xl">{n.title}</h1>
    <p class="margin-note mt-4 text-lg">{n.body}</p>
    <a class="btn-seal mt-8" href="/">Back to the cover</a>
  </section>
</Layout>
