---
import Layout from '../layouts/Layout.astro';
import { atelier, profile } from '../content/profile';
const a = atelier.archive;
---
<Layout title={`${a.title} — earlier work — Emmanuel Osanebi`} description={a.intro}>
  <section class="wrap pt-10" aria-labelledby="h">
    <p class="kicker">Older repos</p>
    <h1 id="h" class="mt-3 text-4xl sm:text-5xl">{a.title}</h1>
    <p class="mt-4 max-w-2xl" style="color:var(--graphite)">{a.intro}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {a.items.map((it) => <li class="card p-5"><h2 class="text-xl"><a href={it.href} rel="noopener">{it.name}</a></h2><p class="mt-1" style="color:var(--graphite)">{it.description}</p></li>)}
    </ul>
    <p class="mt-8"><a class="btn-line" href={profile.contact.links[0].href} rel="me noopener">Everything else on GitHub</a></p>
  </section>
</Layout>
