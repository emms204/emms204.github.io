---
// Alias kept so old links (and their #anchors / ?path= values) keep working. Canonical: /solutions/
import Layout from '../layouts/Layout.astro';
import Body from '../components/works/SolutionsBody.astro';
import Moved from '../components/works/Moved.astro';
import { works } from '../content/profile';
const m = works.solutions.moved;
---
<Layout title="Solutions — Emmanuel Osanebi" description={works.solutions.intro} canonicalPath="/solutions/">
  <div class="wrap pt-6"><Moved from={m.from} note={m.note} to="/solutions/" label="Solutions" /></div>
  <Body />
</Layout>
