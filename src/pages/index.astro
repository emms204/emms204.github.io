---
import Layout from '../layouts/Layout.astro';
import IntentChooser from '../components/works/IntentChooser.astro';
import ProofBench from '../components/works/ProofBench.astro';
import WorkIndex from '../components/works/WorkIndex.astro';
import { profile, atelier, works } from '../content/profile';
import { CONTACT_EMAIL, WHATSAPP_URL } from '../config';
const h = works.hero; const d = works.dimensions;
const featured = atelier.caseFiles.slice(0, 5);
---
<Layout personLd>
  <section id="home" class="hero wrap" aria-labelledby="hero-h">
    <p class="hero-name">{h.name}</p>
    <h1 id="hero-h" class="hero-title"><span class="sr-only">{h.name}: </span>{h.title}</h1>
    <div class="hero-grid">
      <div>
        <p class="hero-statement">{h.statement}</p>
        <ul class="hero-lines">{h.lines.map((l, i) => <li><span class="fig">{String(i + 1).padStart(2, '0')}</span>{l}</li>)}</ul>
      </div>
      <aside class="hero-note" aria-label="How the systems work">
        <p class="kicker">Note · the rule</p>
        <p class="hero-support">{h.support}</p>
        <p class="margin-note">{h.supportNote}</p>
        <p class="hero-role">{h.role}</p>
        <p class="mt-4 flex flex-wrap gap-x-6"><a class="btn-seal" href={h.jump.href}>{h.jump.label}</a><a class="btn-line" href="/cv.pdf">CV (PDF)</a></p>
      </aside>
    </div>
  </section>

  <IntentChooser />

  <ProofBench />

  <section class="wrap minds" aria-labelledby="minds-h">
    <h2 id="minds-h" class="display-2">{d.title}</h2>
    <ol class="minds-list">
      {d.items.map((m, i) => (
        <li class={'mind mind-' + m.key}>
          <p class="kicker">{String(i + 1).padStart(2, '0')} · {m.name}</p>
          <p class="mind-line">{m.line}</p>
          <p class="mt-2">{m.body}</p>
          <p class="mt-2 flex flex-wrap gap-x-5">{m.links.map((l) => <a class="btn-line" href={l.href}>{l.label}</a>)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="work" class="wrap section" aria-labelledby="work-h">
    <span id="projects"></span><span id="portfolio-overview"></span>
    <div class="section-head">
      <h2 id="work-h" class="display-2">{works.selected.title}</h2>
      <p class="margin-note max-w-md">{works.howItRan.note}</p>
    </div>
    <WorkIndex items={featured} />
    <p class="mt-6 flex flex-wrap gap-x-6"><a class="btn-line" href="/work/">{works.selected.all}</a><a class="btn-line" href="/products/">Products</a><a class="btn-line" href="/archive/">{works.selected.archive}</a></p>
  </section>

  <section id="about" class="wrap section" aria-labelledby="about-h">
    <span id="experience"></span>
    <h2 id="about-h" class="display-2">{works.record.title}</h2>
    <div class="about-grid">
      <div>
        {profile.about.paragraphs.map((p) => <p class="mt-3 first:mt-0">{p}</p>)}
        <ol class="record">
          {profile.experience.items.map((e) => (
            <li><p class="kicker">{e.period}</p><h3 class="text-xl">{e.role} · {e.org}</h3><p class="mt-1">{e.summary}</p></li>
          ))}
        </ol>
        <p class="mt-6"><a class="btn-seal" href="/cv.pdf">{works.record.cv}</a></p>
      </div>
      <div id="skills">
        <h3 class="kicker">Tools of the trade</h3>
        {profile.skills.groups.map((g) => (<div class="mt-4"><h4 class="font-semibold">{g.group}</h4><p class="mt-1 text-sm">{g.items.join(' · ')}</p></div>))}
        <p class="mt-6 text-sm">{profile.about.facts.find((f) => f.label === 'Education')?.value}</p>
      </div>
    </div>
  </section>

  <section id="contact" class="wrap section contact-strip" aria-labelledby="contact-h">
    <h2 id="contact-h" class="display-2">{works.contact.title}</h2>
    <div>
      <p class="lede">{works.contact.body}</p>
      <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
        <a class="btn-seal" href="/contact/#inquiry">{works.contact.form}</a>
        <a class="btn-line break-all" href={'mailto:' + CONTACT_EMAIL}>{CONTACT_EMAIL}</a>
        <a class="btn-line" href={WHATSAPP_URL} rel="noopener">{works.contact.whatsapp}</a>
      </p>
    </div>
  </section>
</Layout>
