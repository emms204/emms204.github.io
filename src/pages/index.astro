---
import Layout from '../layouts/Layout.astro';
import InkFlow from '../components/atelier/InkFlow.astro';
import Pencil from '../components/atelier/Pencil.astro';
import CaseCard from '../components/atelier/CaseCard.astro';
import Seal from '../components/atelier/Seal.astro';
import { profile, atelier } from '../content/profile';
import { CONTACT_EMAIL, WHATSAPP_URL } from '../config';
const a = atelier;
const featured = a.caseFiles.slice(0, 4);
const latest = a.press.series.parts[a.press.series.parts.length - 1];
---
<Layout personLd>
  <div class="cover atelier">
    <section id="home" class="wrap pt-10 pb-12 sm:pt-16" aria-labelledby="cover-h">
      <p class="kicker">{a.cover.eyebrow}</p>
      <h1 id="cover-h" class="mt-4 max-w-4xl text-4xl sm:text-6xl">{a.cover.headline}</h1>
      <p class="mt-5 flex flex-wrap gap-x-4 text-lg sm:text-xl" style="font-family:var(--font-serif);font-style:italic;color:var(--graphite)">
        {a.cover.motto.map((m) => <span>{m}</span>)}
      </p>
      <p class="mt-5 max-w-2xl" style="color:var(--graphite)">{a.cover.summary}</p>

      <fieldset class="chooser mt-10">
        <legend class="kicker">{a.cover.chooserLegend}</legend>
        <div class="mt-3 flex flex-wrap gap-2">
          {a.pathways.map((p, i) => (<>
            <input type="radio" name="path" id={'path-' + p.key} value={p.key} checked={i === 0} />
            <label for={'path-' + p.key}>{p.label}</label>
          </>))}
        </div>
        <p class="hint mt-2">{a.cover.chooserHint}</p>
      </fieldset>
      {a.pathways.map((p) => (
        <div class="path-panel card mt-4 p-5 sm:p-7" data-path={p.key}>
          <p class="kicker">Pathway · {p.label}</p>
          <p class="mt-2 max-w-3xl text-2xl sm:text-3xl" style="font-family:var(--font-serif);line-height:1.2">{p.headline}</p>
          <p class="mt-3" style="color:var(--graphite)">{p.first}</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
            <a class="btn-seal" href={p.cta.href}>{p.cta.label}</a>
            <a class="btn-line" href={p.second.href}>{p.second.label}</a>
          </div>
          <nav class="mt-5" aria-label={'Start here, ' + p.label}>
            <p class="kicker">Start here</p>
            <ol class="mt-2 flex flex-wrap gap-x-5">
              {p.start.map((l, i) => <li><a class="inline-flex min-h-11 items-center" href={l.href}><span class="fig mr-2">{i + 1}</span>{l.label}</a></li>)}
            </ol>
          </nav>
        </div>
      ))}
    </section>

    <section class="wrap py-12" aria-labelledby="acts-h">
      <h2 id="acts-h" class="text-3xl sm:text-4xl">Three moves: sketch, ink, sign</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-3">
        {a.acts.map((x) => (
          <li class="rule pt-4">
            <p class="kicker">Act {x.n}</p>
            <h3 class="mt-1 text-2xl">{x.name}</h3>
            <p class="margin-note mt-1">{x.line}</p>
            <p class="mt-2" style="color:var(--graphite)">{x.body}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10">
        <InkFlow />
        <Pencil />
      </div>
    </section>

    <section id="work" class="wrap py-12" aria-labelledby="work-h">
      <span id="projects"></span><span id="portfolio-overview"></span>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="work-h" class="text-3xl sm:text-4xl">Work: case files</h2>
        <a class="btn-line" href="/work/">All case files</a>
      </div>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">{featured.map((c) => <li><CaseCard c={c} /></li>)}</ul>
    </section>

    <section class="wrap py-12 grid gap-8 md:grid-cols-3" aria-label="Shelf, Commission and Press">
      <div class="rule pt-4">
        <p class="kicker">Shelf</p>
        <h2 class="mt-1 text-2xl">{a.shelf.intro}</h2>
        <ul class="mt-3">{a.shelf.items.map((s) => <li><a class="inline-flex min-h-11 items-center" href="/shelf/">{s.name}</a> <span class="chip">{s.status}</span></li>)}</ul>
      </div>
      <div class="rule pt-4">
        <p class="kicker">Commission</p>
        <h2 class="mt-1 text-2xl">Five ways to work together</h2>
        <p class="mt-2" style="color:var(--graphite)">{a.commission.offers.map((o) => o.name).join(' · ')}. {a.commission.priceLabel}: {a.commission.price}.</p>
        <a class="btn-line" href="/commission/">See the offers</a>
      </div>
      <div class="rule pt-4">
        <p class="kicker">Press</p>
        <h2 class="mt-1 text-2xl">{a.press.series.title}</h2>
        <p class="mt-2" style="color:var(--graphite)">{a.press.series.where} · three parts · latest: {latest.part}, {latest.date}</p>
        <a class="btn-line" href="/press/">Read the series</a>
      </div>
    </section>

    <section id="about" class="wrap py-12" aria-labelledby="record-h">
      <span id="experience"></span>
      <h2 id="record-h" class="text-3xl sm:text-4xl">The record</h2>
      <div class="mt-6 grid gap-10 md:grid-cols-[3fr_2fr]">
        <div>
          {profile.about.paragraphs.map((p) => <p class="mt-3 first:mt-0" style="color:var(--graphite)">{p}</p>)}
          <ol class="mt-8 grid gap-5">
            {profile.experience.items.map((e) => (
              <li class="rule pt-3">
                <p class="kicker">{e.period}</p>
                <h3 class="mt-1 text-xl">{e.role} · {e.org}</h3>
                <p class="mt-1" style="color:var(--graphite)">{e.summary}</p>
              </li>
            ))}
          </ol>
          <p class="mt-6"><a class="btn-seal" href="/cv.pdf">{profile.cv.label}</a></p>
        </div>
        <div id="skills">
          <h3 class="kicker">Tools of the trade</h3>
          {profile.skills.groups.map((g) => (
            <div class="mt-4">
              <h4 class="font-semibold">{g.group}</h4>
              <p class="mt-1 text-sm" style="color:var(--graphite)">{g.items.join(' · ')}</p>
            </div>
          ))}
          <p class="mt-6 text-sm" style="color:var(--graphite)">{profile.about.facts.find((f) => f.label === 'Education')?.value}</p>
        </div>
      </div>
    </section>

    <section id="contact" class="wrap py-12" aria-labelledby="sign-h">
      <div class="card flex flex-wrap items-center justify-between gap-6 p-6 sm:p-8">
        <div>
          <h2 id="sign-h" class="text-3xl">Sign here</h2>
          <p class="mt-2 max-w-xl" style="color:var(--graphite)">{a.sign.intro}</p>
          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
            <a class="btn-seal" href="/sign/#brief">{a.sign.formTitle}</a>
            <a class="btn-line" href={'mailto:' + CONTACT_EMAIL}>{CONTACT_EMAIL}</a>
            <a class="btn-line" href={WHATSAPP_URL} rel="noopener">WhatsApp</a>
          </div>
        </div>
        <Seal label="Ready to sign" size={88} />
      </div>
    </section>
  </div>
  <script is:inline>
(()=>{const q=new URLSearchParams(location.search).get('path'),r=q&&document.getElementById('path-'+q);if(r)r.checked=true;
document.querySelectorAll('input[name=path]').forEach(i=>i.addEventListener('change',()=>{const u=new URL(location);u.searchParams.set('path',i.value);history.replaceState(null,'',u)}))})();
  </script>
</Layout>
