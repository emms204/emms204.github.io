---
import Layout from '../layouts/Layout.astro';
import IntentChooser from '../components/works/IntentChooser.astro';
import PrivacyLens from '../components/works/PrivacyLens.astro';
import StoryEngine from '../components/works/StoryEngine.astro';
import LivingSystem from '../components/works/LivingSystem.astro';
import Journey from '../components/works/Journey.astro';
import LettersCard from '../components/works/LettersCard.astro';
import { profile, works } from '../content/profile';
import { CONTACT_EMAIL, WHATSAPP_URL } from '../config';
const h = works.hero;
---
<Layout personLd>
  <div class="first-screen">
  <section id="home" class="hero hero-v7 wrap" aria-labelledby="hero-h">
    <div class="hero-main">
      <p class="hero-brand">{h.title}</p>
      <h1 id="hero-h" class="hero-h1">{h.name}</h1>
      <p class="hero-statement">{h.statement}</p>
    </div>
    <div class="hero-side">
      <p class="hero-offer">{h.offer}</p>
      <ul class="hero-lines" aria-label="What I make">{h.lines.map((l) => <li>{l}</li>)}</ul>
      <p class="hero-ctas"><a class="btn-seal" href={h.cta.href}>{h.cta.label}</a><a class="btn-line" href={h.cta2.href}>{h.cta2.label}</a><a class="btn-line" href="/cv.pdf">CV (PDF)</a></p>
    </div>
  </section>

  <LivingSystem />
  </div>

  <IntentChooser />

  <section id="bench" class="pieces" aria-labelledby="pieces-h">
    <span id="projects"></span><span id="portfolio-overview"></span><span id="work"></span>
    <div class="wrap"><h2 id="pieces-h" class="display-2">{works.pieces.title}</h2>
      <ol class="pieces-index">{works.pieces.items.map((p, i) => <li><a href={p.href}><span class="fig">{String(i + 1).padStart(2, '0')}</span> {p.label}</a></li>)}</ol>
    </div>
    <div class="pieces-stack" data-folds>
      {[PrivacyLens, StoryEngine].map((Piece, i) => (
        <details class="fold" open={i === 0}>
          <summary class="fold-sum"><span class="fig">{String(i + 1).padStart(2, '0')}</span><span class="fold-area">{works.pieces.items[i].label}</span><span class="fold-name">{works.pieces.names[i]}</span><span class="fold-hint" aria-hidden="true"></span></summary>
          <Piece />
        </details>
      ))}
    </div>
  </section>

  <Journey />

  <LettersCard />

  <section id="about" class="wrap section" aria-labelledby="about-h">
    <h2 id="about-h" class="display-2">{works.record.title}</h2>
    <div class="about-grid">
      <div>
        <p>{profile.about.paragraphs[0]}</p>
        <figure class="about-quote">
          <blockquote><p>Man is the only animal that refuses to be what he is.</p></blockquote>
          <figcaption>From my letter <a href="/letters/sorrow-sorrow-prayers/">Sorrow, sorrow, prayers</a></figcaption>
        </figure>
        <p class="mt-4">Liverpool supporter.</p>
        <p class="mt-1"><a class="btn-line" href="/chess/">One bullet chess game, annotated</a></p>
        <p class="mt-6"><a class="btn-seal" href="/cv.pdf">{works.record.cv}</a></p>
      </div>
      <div id="skills">
        <h3 class="kicker">Tools of the trade</h3>
        <dl class="skills-compact">
          {profile.skills.groups.map((g) => (<div><dt>{g.group}</dt><dd>{g.items.join(' · ')}</dd></div>))}
          <div><dt>Education</dt><dd>{profile.about.facts.find((f) => f.label === 'Education')?.value}</dd></div>
        </dl>
        <p class="mt-4 text-sm">The full record, role by role, is in <a href="#journey">the engineering journey</a> above and in the <a href="/cv.pdf">CV</a>.</p>
      </div>
    </div>
  </section>

  <section id="contact" class="wrap section contact-strip" aria-labelledby="contact-h">
    <h2 id="contact-h" class="display-2">{works.contact.title}</h2>
    <div>
      <p class="lede">{works.contact.body}</p>
      <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
        <a class="btn-seal" href="/contact/#inquiry">{works.contact.form}</a>
        <a class="btn-line break-all" href={'mailto:' + CONTACT_EMAIL}>{CONTACT_EMAIL}</a>
        <a class="btn-line" href={WHATSAPP_URL} rel="noopener">{works.contact.whatsapp}</a>
      </p>
    </div>
  </section>
</Layout>
<script is:inline>
(()=>{const o=()=>{const t=location.hash&&document.getElementById(location.hash.slice(1));const d=t&&t.closest('details');if(d&&!d.open){d.open=true;t.scrollIntoView()}};addEventListener('hashchange',o);o()})();
</script>
