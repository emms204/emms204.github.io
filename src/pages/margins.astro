import Layout from '../layouts/Layout.astro';
import Moved from '../components/works/Moved.astro';
---
<Layout title="Margins — moved to Letters — Emmanuel Osanebi" description="Margins is now part of Letters." canonicalPath="/letters/">
  <section class="wrap pt-6" aria-labelledby="h">
