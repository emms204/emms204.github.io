---
// Alias kept so old links (and their #anchors / ?path= values) keep working. Canonical: /journal/
import Layout from '../layouts/Layout.astro';
import Body from '../components/works/JournalBody.astro';
import Moved from '../components/works/Moved.astro';
import { works } from '../content/profile';
const m = works.journal.moved;
---
<Layout title="Journal — Emmanuel Osanebi" description={works.journal.intro} canonicalPath="/journal/">
  <div class="wrap pt-6"><Moved from={m.from} note={m.note} to="/journal/" label="Journal" /></div>
  <Body />
</Layout>
