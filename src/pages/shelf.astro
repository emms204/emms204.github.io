---
import Layout from '../layouts/Layout.astro';
import Seal from '../components/atelier/Seal.astro';
import Placeholder from '../components/atelier/Placeholder.astro';
import { atelier } from '../content/profile';
const s = atelier.shelf;
---
<Layout title={`${s.title} — products — Emmanuel Osanebi`} description={s.intro}>
  <section class="wrap pt-10" aria-labelledby="h">
    <p class="kicker">Products</p>
    <h1 id="h" class="mt-3 text-4xl sm:text-5xl">{s.title}</h1>
    <p class="mt-4 max-w-2xl" style="color:var(--graphite)">{s.intro}</p>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      {s.items.map((it) => (
        <li class="card flex flex-col p-6">
          <div class="flex items-start justify-between gap-4">
            <div><h2 class="text-2xl">{it.name}</h2><p class="mt-1"><span class="chip">{it.status}</span> {it.period && <span class="kicker ml-2">{it.period}</span>}</p></div>
            {it.sealed && <Seal label="Shipped" size={56} />}
          </div>
          <p class="mt-3" style="color:var(--graphite)">{it.description}</p>
          <ul class="mt-3 flex flex-wrap gap-x-5">{it.links.map((l) => <li><a class="inline-flex min-h-11 items-center" href={l.href} rel="noopener">{l.label}</a></li>)}</ul>
          <div class="mt-3"><Placeholder need={it.pending} /></div>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-xl" style="font-family:var(--font-serif)">{s.cta} <a class="btn-seal ml-2" href="/sign/?path=customer#brief">Get in touch</a></p>
  </section>
</Layout>
