---
// Alias kept so old links (and their #anchors / ?path= values) keep working. Canonical: /products/
import Layout from '../layouts/Layout.astro';
import Body from '../components/works/ProductsBody.astro';
import Moved from '../components/works/Moved.astro';
import { works } from '../content/profile';
const m = works.products.moved;
---
<Layout title="Products — Emmanuel Osanebi" description={works.products.intro} canonicalPath="/products/">
  <div class="wrap pt-6"><Moved from={m.from} note={m.note} to="/products/" label="Products" /></div>
  <Body />
</Layout>
