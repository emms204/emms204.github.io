---
// Alias kept so old links (and their #anchors / ?path= values) keep working. Canonical: /contact/
import Layout from '../layouts/Layout.astro';
import Body from '../components/works/ContactBody.astro';
import Moved from '../components/works/Moved.astro';
import { works } from '../content/profile';
const m = works.inquiry.moved;
---
<Layout title="Contact — Emmanuel Osanebi" description={works.inquiry.intro} canonicalPath="/contact/">
  <div class="wrap pt-6"><Moved from={m.from} note={m.note} to="/contact/" label="Contact" /></div>
  <Body />
</Layout>
