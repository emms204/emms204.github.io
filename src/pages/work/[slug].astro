---
import Layout from '../../layouts/Layout.astro';
import InkFlow from '../../components/atelier/InkFlow.astro';
import Pencil from '../../components/atelier/Pencil.astro';
import RetakeStrip from '../../components/atelier/RetakeStrip.astro';
import Seal from '../../components/atelier/Seal.astro';
import { atelier, type CaseFile } from '../../content/profile';
export function getStaticPaths() { return atelier.caseFiles.map((c) => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props as { c: CaseFile };
const w = atelier.work;
---
<Layout title={`${c.title} — case file — Emmanuel Osanebi`} description={c.summary}>
  <article class="atelier">
    <header class="wrap pt-10 pb-4">
      <p class="kicker"><a href="/work/">Work</a> · {c.context}{c.period && ` · ${c.period}`}</p>
      <h1 class="mt-3 max-w-4xl text-4xl sm:text-5xl">{c.title}</h1>
      <p class="mt-4 max-w-2xl text-lg" style="color:var(--graphite)">{c.summary}</p>
    </header>
    <div class="wrap grid gap-10 md:grid-cols-[7fr_3fr]">
      <div>
        <section class="rule mt-6 pt-4" aria-labelledby="s1">
          <p class="kicker">How it ran · I</p><h2 id="s1" class="mt-1 text-2xl">Sketch</h2>
          <p class="margin-note mt-2 text-lg">{c.sketch}</p>
        </section>
        <section class="rule mt-8 pt-4" aria-labelledby="s2">
          <p class="kicker">How it ran · II</p><h2 id="s2" class="mt-1 text-2xl">Ink</h2>
          <ul class="mt-3 grid list-disc gap-2 pl-5">{c.ink.map((x) => <li>{x}</li>)}</ul>
          {c.diagram && <div class="mt-6"><InkFlow /><Pencil /></div>}
        </section>
        <section class="rule mt-8 pt-4" aria-labelledby="s3">
          <p class="kicker">How it ran · III</p><h2 id="s3" class="mt-1 text-2xl">Sign</h2>
          <div class="mt-3 flex flex-wrap items-start justify-between gap-6">
            <ul class="grid list-disc gap-2 pl-5">{c.sign.map((x) => <li>{x}</li>)}</ul>
            {c.sealed && <Seal label={c.sealLabel} size={84} />}
          </div>
          {c.figures.length > 0 && (
            <dl class="mt-6 grid gap-4 sm:grid-cols-2">
              {c.figures.map((f) => (
                <div class="card p-4"><dt class="sr-only">{f.label}</dt><dd><span class="fig text-3xl">{f.value}</span><span class="block">{f.label}</span><span class="kicker mt-1 block">Source: {f.source}</span></dd></div>
              ))}
            </dl>
          )}
        </section>
        {c.retake && <RetakeStrip retake={c.retake} />}
      </div>
      <aside class="md:pt-6" aria-label="Stack and links">
        <h2 class="kicker">Stack</h2>
        <p class="mt-2 flex flex-wrap gap-1.5">{c.stack.map((s) => <span class="chip">{s}</span>)}</p>
        {c.links.length > 0 && (<>
          <h2 class="kicker mt-6">Links</h2>
          <ul class="mt-1">{c.links.map((l) => <li><a class="inline-flex min-h-11 items-center" href={l.href} rel="noopener">{l.label}</a></li>)}</ul>
        </>)}
      </aside>
    </div>
    <footer class="wrap mt-12">
      <div class="card flex flex-wrap items-center justify-between gap-4 p-6">
        <p class="text-2xl" style="font-family:var(--font-serif)">{w.cta}</p>
        <a class="btn-seal" href={'/contact/?intent=build#inquiry'}>{w.ctaLink.label}</a>
      </div>
    </footer>
  </article>
</Layout>
