---
import Layout from '../../layouts/Layout.astro';
import WorkIndex from '../../components/works/WorkIndex.astro';
import { atelier, works } from '../../content/profile';
const w = atelier.work;
---
<Layout title={`${w.title} — case files — Emmanuel Osanebi`} description={w.intro}>
  <section class="wrap pt-10 pb-6" aria-labelledby="h">
    <p class="kicker">Case files</p>
    <h1 id="h" class="display-1">{w.title}</h1>
    <p class="mt-4 max-w-2xl" style="color:var(--graphite)">{w.intro}</p>
  </section>
  <section class="wrap" aria-label="All case files">
    <p class="margin-note mb-6 max-w-2xl">{works.howItRan.note}</p>
    <WorkIndex items={atelier.caseFiles} level="h2" />
    <p class="mt-10 text-xl" style="font-family:var(--font-serif)">{w.cta} <a class="btn-seal ml-2" href={'/contact/?intent=build#inquiry'}>{w.ctaLink.label}</a></p>
    <p class="mt-4"><a class="btn-line" href="/archive/">Earlier work in the archive</a></p>
  </section>
</Layout>
