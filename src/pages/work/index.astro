---
import Layout from '../../layouts/Layout.astro';
import CaseCard from '../../components/atelier/CaseCard.astro';
import { atelier } from '../../content/profile';
const w = atelier.work;
---
<Layout title={`${w.title} — case files — Emmanuel Osanebi`} description={w.intro}>
  <section class="wrap pt-10 pb-6" aria-labelledby="h">
    <p class="kicker">Case files</p>
    <h1 id="h" class="mt-3 text-4xl sm:text-5xl">{w.title}</h1>
    <p class="mt-4 max-w-2xl" style="color:var(--graphite)">{w.intro}</p>
  </section>
  <section class="wrap" aria-label="All case files">
    <ul class="grid gap-4 sm:grid-cols-2">{atelier.caseFiles.map((c) => <li><CaseCard c={c} level="h2" /></li>)}</ul>
    <p class="mt-10 text-xl" style="font-family:var(--font-serif)">{w.cta} <a class="btn-seal ml-2" href={w.ctaLink.href}>{w.ctaLink.label}</a></p>
    <p class="mt-4"><a class="btn-line" href="/archive/">Earlier work in the archive</a></p>
  </section>
</Layout>
